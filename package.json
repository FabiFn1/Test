{
  "name": "schichtwerk",
  "productName": "Schichtwerk",
  "version": "1.2.0",
  "description": "Schichtwerk – Fabrik-Aufbauspiel",
  "main": "main.js",
  "author": "FabiFn1",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "prepare-assets": "node scripts/prepare-assets.js",
    "dist": "npm run prepare-assets && electron-builder --win nsis portable --publish never",
    "android:sync": "npm run prepare-assets && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "build:game": "node scripts/build-game.js"
  },
  "build": {
    "appId": "de.fabifn1.schichtwerk",
    "productName": "Schichtwerk",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Schichtwerk.exe"
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "artifactName": "Schichtwerk-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Schichtwerk",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "three": "^0.160.0",
    "@capacitor/core": "^7.6.10"
  }
}
